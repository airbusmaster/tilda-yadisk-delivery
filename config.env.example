# Скопируйте в config.env рядом с app.py и заполните.
# config.env содержит секреты и НЕ должен попадать в git.

PORT=8091

# Название магазина — подставляется в подпись письма и заголовок админки
SHOP_NAME=Магазин

# Домен, с которого раздаются ссылки покупателям (за nginx)
PUBLIC_BASE_URL=https://files.example.com

# Публичная папка Яндекс.Диска с файлами товаров.
# Достаточно «Поделиться» → ссылка на папку, авторизация не нужна.
YADISK_PUBLIC_KEY=https://disk.360.yandex.ru/d/XXXXXXXXXXXX

# Сколько живёт ссылка и сколько раз по ней можно скачать файл.
# Скачивание засчитывается только когда файл доехал до конца.
LINK_TTL_HOURS=720
MAX_DOWNLOADS=20

# Секретный сегмент URL вебхука: https://<домен>/hook/<WEBHOOK_SECRET>
# Сгенерировать: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
WEBHOOK_SECRET=

# Секретный сегмент URL админки: https://<домен>/admin/<ADMIN_SECRET>
ADMIN_SECRET=

# Почта отправителя. Для Яндекс 360 — пароль приложения, не пароль от аккаунта.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=order@example.com
SMTP_PASSWORD=
MAIL_FROM_NAME=
SUPPORT_EMAIL=
MAIL_SUBJECT=Ваш заказ готов к скачиванию
MAIL_SIGNOFF=С уважением,

# Копия отправленного письма в папку «Отправленные» по IMAP
IMAP_HOST=imap.yandex.ru
SAVE_TO_SENT=1

# Отчёты и алерты владельцу. TG_CHAT_ID подставит set_tg_chat.py
TG_BOT_TOKEN=
TG_CHAT_ID=

# Через сколько часов без единого скачивания дёрнуть владельца
NUDGE_AFTER_HOURS=24

# 1 = письма не отправлять, только писать в лог
DRY_RUN=0
