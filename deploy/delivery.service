[Unit]
Description=Автовыдача цифровых товаров (Tilda webhook -> письмо покупателю)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/delivery
ExecStart=/usr/bin/python3 /opt/delivery/app.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
